BUILD   := build

CROSS   := aarch64-linux-gnu-
CC      := $(CROSS)gcc
OBJCOPY := $(CROSS)objcopy
OBJDUMP := $(CROSS)objdump
QEMU    := qemu-system-aarch64

CFLAGS   := -Wall -Wextra -Werror -ffreestanding -mgeneral-regs-only -g -O0 \
            -Iinclude -I$(BUILD) -MMD -MP
LDCOMMON := -nostdlib -nostartfiles -static -no-pie -Wl,--build-id=none

objs = $(addprefix $(BUILD)/,$(addsuffix .o,$(basename $(1))))

# bootloader
BOOT_LD   := bootloader/linker_script.ld
BOOT_SRCS := $(wildcard bootloader/*.c bootloader/*.s \
                        drivers/*.c drivers/*.s lib/*.c lib/*.s)
BOOT_OBJS := $(call objs,$(BOOT_SRCS))
TARGET    := $(BUILD)/kernel.elf

# payload
PAYLOAD_ADDR := 0x41000000
PAYLOAD_LD   := payload/linker.ld
PAYLOAD_SRCS := $(wildcard payload/*.c payload/*.s) drivers/uart.c lib/kprintf.c
PAYLOAD_OBJS := $(call objs,$(PAYLOAD_SRCS))
PAYLOAD_ELF  := $(BUILD)/payload/payload.elf
PAYLOAD_BIN  := $(BUILD)/payload.bin
PAYLOAD_INFO := $(BUILD)/payload_info.h
PAYLOAD_BAD  := $(BUILD)/payload_tampered.bin

QEMU_BASE  := -machine virt -cpu cortex-a53 -nographic
QEMU_FLAGS := $(QEMU_BASE) -kernel $(TARGET)

# targets
all: $(TARGET) $(PAYLOAD_BIN)

$(TARGET): $(BOOT_OBJS) $(BOOT_LD)
	$(CC) $(CFLAGS) $(LDCOMMON) -T $(BOOT_LD) $(BOOT_OBJS) -o $@

$(PAYLOAD_ELF): $(PAYLOAD_OBJS) $(PAYLOAD_LD)
	$(CC) $(CFLAGS) $(LDCOMMON) -T $(PAYLOAD_LD) $(PAYLOAD_OBJS) -o $@

$(PAYLOAD_BIN): $(PAYLOAD_ELF)
	$(OBJCOPY) -O binary $< $@

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/%.o: %.s
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(PAYLOAD_INFO): $(PAYLOAD_BIN)
	@echo "GEN $@"
	@{ \
	  echo "#ifndef PAYLOAD_INFO_H"; \
	  echo "#define PAYLOAD_INFO_H"; \
	  echo "/* generated by the Makefile from $(PAYLOAD_BIN), do not edit */"; \
	  echo "#define PAYLOAD_ADDR $(PAYLOAD_ADDR)UL"; \
	  echo "#define PAYLOAD_SIZE $$(wc -c < $<)UL"; \
	  echo "#define PAYLOAD_SHA256 { $$(sha256sum $< | cut -d' ' -f1 | sed 's/../0x&, /g') }"; \
	  echo "#endif"; \
	} > $@

# the bootloader's main must be rebuilt when the payload (and so its hash) changes
$(BUILD)/bootloader/main.o: $(PAYLOAD_INFO)

# copy of the payload with one byte changed, to test that the bootloader refuses it
$(PAYLOAD_BAD): $(PAYLOAD_BIN)
	cp $< $@
	printf '\132' | dd of=$@ bs=1 seek=100 conv=notrunc 2>/dev/null

# bootloader only
run: $(TARGET)
	$(QEMU) $(QEMU_FLAGS)

# payload alone
run-payload: $(PAYLOAD_ELF)
	$(QEMU) $(QEMU_BASE) -kernel $(PAYLOAD_ELF)

# bootloader + payload.bin
run-boot: $(TARGET) $(PAYLOAD_BIN)
	$(QEMU) $(QEMU_FLAGS) -device loader,file=$(PAYLOAD_BIN),addr=$(PAYLOAD_ADDR)

# bootloader + manipulated payload
run-boot-bad: $(TARGET) $(PAYLOAD_BAD)
	$(QEMU) $(QEMU_FLAGS) -device loader,file=$(PAYLOAD_BAD),addr=$(PAYLOAD_ADDR)

debug: $(TARGET)
	$(QEMU) $(QEMU_FLAGS) -S -s

gdb: $(TARGET)
	gdb-multiarch $(TARGET) -ex "target remote :1234"

disasm: $(TARGET)
	$(OBJDUMP) -d $(TARGET)

disasm-payload: $(PAYLOAD_ELF)
	$(OBJDUMP) -d $(PAYLOAD_ELF)

clean:
	rm -rf $(BUILD)

re: clean all

-include $(BOOT_OBJS:.o=.d) $(PAYLOAD_OBJS:.o=.d)

.PHONY: all run run-payload run-boot run-boot-bad debug gdb disasm disasm-payload clean re